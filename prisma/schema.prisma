
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Event {
  id          Int          @id @default(autoincrement())
  slug        String       @unique
  title       String
  goal        Int
  raised      Int          @default(0)
  createdAt   DateTime     @default(now())

  investments Investment[]   // ← relación inversa obligatoria
}

model Investment {
  id        Int      @id @default(autoincrement())
  amount    Int
  eventId   Int
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
}
